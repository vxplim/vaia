{
  "name": "vaia",
  "productName": "VAIA",
  "version": "0.0.1",
  "description": "A calm, sidebar-first browser for Mac",
  "author": "Vanessa Minerva Lim",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
